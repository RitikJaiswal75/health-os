{
  "expo": {
    "name": "Health OS",
    "owner": "ritikj1",
    "slug": "health-os-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo-adaptive.png",
    "scheme": "healthos",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/Logo-adaptive.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.health.os",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSCameraUsageDescription": "Health OS uses the camera to photograph your pill for easy identification.",
        "NSPhotoLibraryUsageDescription": "Health OS uses your photo library to pick a pill image."
      }
    },
    "android": {
      "package": "com.health.os",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/Logo-adaptive.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "SYSTEM_ALERT_WINDOW",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo-adaptive.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Health OS uses your photos to pick a pill image.",
          "cameraPermission": "Health OS uses the camera to photograph your pill."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#121212",
          "defaultChannel": "medication-reminders"
        }
      ],
      "./modules/medication-alarm/app.plugin.js",
      "./plugins/withDevClientMainApplication.js",
      "./plugins/withReleaseApkOptimization.js",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c5d818a-aa53-4103-877e-fd3e546f9c95"
      }
    }
  }
}
